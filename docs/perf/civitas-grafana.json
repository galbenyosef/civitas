        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "fillOpacity": 40,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
