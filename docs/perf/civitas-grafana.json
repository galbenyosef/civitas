      "type": "timeseries",
      "title": "Event-loop lag and GC pauses",
      "description": "How late timers ran since the last scrape (the tick is a timer: lag is a late tick that is not the simulation's fault) and the garbage collector's pauses.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 35
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_event_loop_lag_ms{world=~\"$world\",stat=\"p95\"}",
          "legendFormat": "{{world}} loop lag p95"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_event_loop_lag_ms{world=~\"$world\",stat=\"max\"}",
          "legendFormat": "{{world}} loop lag max"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_gc_pause_max_ms{world=~\"$world\"}",
          "legendFormat": "{{world}} worst GC pause (1m)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "rate(civitas_gc_ms_total{world=~\"$world\"}[1m])*1000",
          "legendFormat": "{{world}} GC ms per second"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "fillOpacity": 8,
            "lineWidth": 2,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
