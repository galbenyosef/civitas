    {
      "type": "timeseries",
      "title": "Tick time against the budget",
      "description": "The loop (simulation ticks, the systems, the network flush) over the last minute: average, 95th percentile and worst. The red band is the 200 ms interval: a tick over it delays the next one and the clients see a late frame.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_tick_ms{world=~\"$world\",stat=\"avg\"}",
          "legendFormat": "{{world}} avg"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_tick_ms{world=~\"$world\",stat=\"p95\"}",
          "legendFormat": "{{world}} p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_tick_ms{world=~\"$world\",stat=\"max\"}",
          "legendFormat": "{{world}} max"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "civitas_tick_budget_ms{world=~\"$world\"}",
          "legendFormat": "budget"
        }
      ],
